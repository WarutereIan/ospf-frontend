# Frontend environment (Vite)
# Copy to .env or .env.production and set values for your deployment.
# Vite only exposes variables prefixed with VITE_

# ============================================
# API (Backend)
# ============================================
# Full base URL of the backend API (no trailing slash).
# - Local: http://localhost:3000
# - Production (same domain): https://ofsp.jirani.store
# - Production (API subdomain): https://api.ofsp.jirani.store
VITE_API_BASE_URL=https://ofsp.jirani.store

# API path prefix (must match backend API_PREFIX).
VITE_API_PREFIX=api/v1
